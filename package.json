{
  "name": "mediafetch",
  "version": "1.0.0",
  "description": "Download video & audio dari YouTube, Instagram, TikTok untuk penggunaan pribadi",
  "main": "main.js",
  "bin": "server.js",
  "author": "Your Name",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "app:dev": "electron .",
    "dev": "nodemon server.js",
    "check": "node scripts/check-tools.js",
    "setup": "npm install && npm run check",
    "logs": "cat logs/app.log",
    "clear-logs": "rm -f logs/app.log",
    "test": "echo 'Tests not implemented yet' && exit 0",
    "build": "pkg . --targets node18-win-x64 --output dist/FytX.exe",
    "build:exe": "node scripts/build-exe.js",
    "build:electron": "electron-builder",
    "build:app": "node scripts/build-electron-obf.js"
  },
  "build": {
    "appId": "com.fythhx.app",
    "productName": "FythhX",
    "electronVersion": "44.4.2",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "portable"
    },
    "files": [
      "**/*",
      "!node_modules/electron",
      "!node_modules/electron-builder",
      "!dist",
      "!dist-electron",
      "!logs",
      "!cache"
    ]
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "views/**/*",
      "config/**/*"
    ]
  },
  "keywords": [
    "video-download",
    "youtube",
    "instagram",
    "tiktok",
    "facebook",
    "twitter",
    "reddit",
    "vimeo",
    "media-downloader",
    "yt-dlp",
    "ffmpeg"
  ],
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "axios": "^1.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "node-machine-id": "^1.1.12"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "44.4.2",
    "electron-builder": "^26.15.3",
    "fs-extra": "^11.4.0",
    "javascript-obfuscator": "^5.6.0",
    "nodemon": "^3.0.1",
    "pkg": "^5.8.1"
  }
}

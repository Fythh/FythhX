{
  "name": "mediafetch",
  "version": "1.0.0",
  "description": "Download video & audio dari YouTube, Instagram, TikTok untuk penggunaan pribadi",
  "main": "server.js",
  "author": "Your Name",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node scripts/check-tools.js",
    "setup": "npm install && npm run check",
    "logs": "cat logs/app.log",
    "clear-logs": "rm -f logs/app.log",
    "test": "echo 'Tests not implemented yet' && exit 0",
    "build": "pkg . --targets node18-win-x64 --output dist/FytX.exe"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "views/**/*"
    ]
  },
  "keywords": [
    "video-download",
    "youtube",
    "instagram",
    "tiktok",
    "facebook",
    "twitter",
    "reddit",
    "vimeo",
    "media-downloader",
    "yt-dlp",
    "ffmpeg"
  ],
  "dependencies": {
    "axios": "^1.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "node-machine-id": "^1.1.12"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "pkg": "^5.8.1"
  }
}

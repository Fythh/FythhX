# MediaFetch Environment Configuration
# Copy file ini menjadi .env dan sesuaikan nilai-nilainya

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Download Configuration
DOWNLOAD_DIR=./downloads
MAX_DOWNLOAD_SIZE=5000  # dalam MB

# yt-dlp Configuration
YT_DLP_PATH=yt-dlp
YTDLP_QUIET=false
YTDLP_NO_WARNINGS=true

# ffmpeg Configuration
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
AUDIO_BITRATE=192k

# Supported Platforms
SUPPORTED_PLATFORMS=youtube,instagram,tiktok,facebook,twitter,reddit,vimeo

# CORS Configuration
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

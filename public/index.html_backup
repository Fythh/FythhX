    <!-- Template for Toasts -->
    <template id="toastTemplate">
        <div class="toast-item glass-panel glass-inner border-l-4 p-4 rounded shadow-lg flex items-start gap-3 min-w-[300px] toast-enter">
            <span class="material-symbols-outlined toast-icon mt-0.5"></span>
            <div class="flex-grow">
                <h4 class="toast-title font-bold text-sm mb-1"></h4>
                <p class="toast-message text-xs opacity-80"></p>
            </div>
            <button class="toast-close text-outline-variant hover:text-white transition-colors">
                <span class="material-symbols-outlined text-sm">close</span>
            </button>
        </div>
    </template>


  <!-- Modal Visualization Crop Mode -->
  <div id="cropModal" class="fixed inset-0 bg-black/80 flex items-center justify-center z-[100] hidden opacity-0 transition-opacity duration-300 p-4 backdrop-blur-sm">
    <div class="bg-surface p-6 rounded-2xl w-full max-w-4xl border border-white/10 shadow-2xl relative">
      <button id="closeCropModal" class="absolute top-4 right-4 text-white/50 hover:text-white bg-white/5 hover:bg-white/10 rounded-full p-2 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
      <h3 class="text-xl font-bold mb-6 text-on-surface">Visualisasi Mode Crop (Sumber Video Landscape)</h3>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
        <!-- Default -->
        <div class="flex flex-col items-center">
          <div class="w-32 h-18 bg-black border-2 border-white/20 rounded mb-2 relative flex items-center justify-center overflow-hidden" style="aspect-ratio: 16/9;">
            <div class="absolute w-[40%] h-full bg-primary/40 flex items-center justify-center text-[8px] font-bold text-center">Center<br/>Fit</div>
          </div>
          <span class="text-xs font-bold text-center">Default</span>
        </div>
        <!-- Split Left -->
        <div class="flex flex-col items-center">
          <div class="w-32 h-18 bg-black border-2 border-white/20 rounded mb-2 relative flex items-center justify-center overflow-hidden" style="aspect-ratio: 16/9;">
            <div class="absolute w-[40%] h-full bg-blue-500/40 flex items-center justify-center text-[8px] font-bold text-center">Gameplay</div>
            <div class="absolute w-[20%] h-[35%] bg-green-500/60 bottom-0 left-0 flex items-center justify-center text-[8px] font-bold">Cam</div>
          </div>
          <span class="text-xs font-bold text-center">Split Left</span>
        </div>
        <!-- Split Right -->
        <div class="flex flex-col items-center">
          <div class="w-32 h-18 bg-black border-2 border-white/20 rounded mb-2 relative flex items-center justify-center overflow-hidden" style="aspect-ratio: 16/9;">
            <div class="absolute w-[40%] h-full bg-blue-500/40 flex items-center justify-center text-[8px] font-bold text-center">Gameplay</div>
            <div class="absolute w-[20%] h-[35%] bg-green-500/60 bottom-0 right-0 flex items-center justify-center text-[8px] font-bold">Cam</div>
          </div>
          <span class="text-xs font-bold text-center">Split Right</span>
        </div>
        <!-- Split Left Mid -->
        <div class="flex flex-col items-center">
          <div class="w-32 h-18 bg-black border-2 border-white/20 rounded mb-2 relative flex items-center justify-center overflow-hidden" style="aspect-ratio: 16/9;">
            <div class="absolute w-[40%] h-full bg-blue-500/40 flex items-center justify-center text-[8px] font-bold text-center">Gameplay</div>
            <div class="absolute w-[20%] h-[35%] bg-purple-500/60 left-0 top-1/2 -translate-y-1/2 flex items-center justify-center text-[8px] font-bold">Cam</div>
          </div>
          <span class="text-xs font-bold text-center">Split Left Mid</span>
        </div>
        <!-- Split Right Mid -->
        <div class="flex flex-col items-center">
          <div class="w-32 h-18 bg-black border-2 border-white/20 rounded mb-2 relative flex items-center justify-center overflow-hidden" style="aspect-ratio: 16/9;">
            <div class="absolute w-[40%] h-full bg-blue-500/40 flex items-center justify-center text-[8px] font-bold text-center">Gameplay</div>
            <div class="absolute w-[20%] h-[35%] bg-purple-500/60 right-0 top-1/2 -translate-y-1/2 flex items-center justify-center text-[8px] font-bold">Cam</div>
          </div>
          <span class="text-xs font-bold text-center">Split Right Mid</span>
        </div>
      </div>
      <p class="text-xs text-on-surface-variant mt-4 text-center">Visualisasi di atas menunjukkan <b>dari mana</b> area Facecam dan Gameplay dipotong pada video asli.</p>
    </div>
  </div>

  <!-- Modal Visualization Facecam Position Output -->
  <div id="posModal" class="fixed inset-0 bg-black/80 flex items-center justify-center z-[100] hidden opacity-0 transition-opacity duration-300 p-4 backdrop-blur-sm">
    <div class="bg-surface p-6 rounded-2xl w-full max-w-lg border border-white/10 shadow-2xl relative">
      <button id="closePosModal" class="absolute top-4 right-4 text-white/50 hover:text-white bg-white/5 hover:bg-white/10 rounded-full p-2 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
      <h3 class="text-xl font-bold mb-6 text-on-surface text-center">Visualisasi Hasil Output (9:16)</h3>
      <div class="flex justify-center gap-10">
        <!-- Posisi Face Cam Dibawah -->
        <div class="flex flex-col items-center">
          <div class="w-24 h-40 bg-black border-2 border-white/20 rounded mb-2 flex flex-col overflow-hidden">
            <div class="w-full h-2/3 bg-blue-500/40 flex items-center justify-center text-[10px] font-bold text-center">Bagian<br/>Tengah<br/>(Gameplay)</div>
            <div class="w-full h-1/3 bg-green-500/40 flex items-center justify-center text-[10px] font-bold text-center">Bagian<br/>Face Cam</div>
          </div>
          <span class="text-xs font-bold text-center">Posisi Dibawah</span>
        </div>
        <!-- Posisi Face Cam Diatas -->
        <div class="flex flex-col items-center">
          <div class="w-24 h-40 bg-black border-2 border-white/20 rounded mb-2 flex flex-col overflow-hidden">
            <div class="w-full h-1/3 bg-green-500/40 flex items-center justify-center text-[10px] font-bold text-center">Bagian<br/>Face Cam</div>
            <div class="w-full h-2/3 bg-blue-500/40 flex items-center justify-center text-[10px] font-bold text-center">Bagian<br/>Tengah<br/>(Gameplay)</div>
          </div>
          <span class="text-xs font-bold text-center">Posisi Diatas</span>
        </div>
      </div>
    </div>
    
    </div>
  </div>

  <!-- Storage Media Player Modal -->
  <div id="storagePlayerModal" class="fixed inset-0 z-[100] hidden flex items-center justify-center p-4 md:p-6 backdrop-blur-md bg-black/40 transition-opacity">
      <div class="glass-panel w-full max-w-3xl rounded-3xl shadow-2xl border border-white/10 overflow-hidden flex flex-col transform scale-100 transition-all duration-300">
          <!-- Header -->
          <div class="px-6 py-4 border-b border-white/10 flex items-center justify-between bg-white/5">
              <div class="flex items-center gap-3 overflow-hidden">
                  <div class="w-8 h-8 rounded-full bg-primary/20 flex items-center justify-center flex-shrink-0">
                      <span class="material-symbols-outlined text-primary text-sm">play_circle</span>
                  </div>
                  <h3 id="storagePlayerTitle" class="text-white text-base md:text-lg font-bold truncate pr-4">Media Player</h3>
              </div>
              <button id="closeStoragePlayer" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors flex-shrink-0">
                  <span class="material-symbols-outlined text-sm">close</span>
              </button>
          </div>
          <!-- Media Area -->
          <div id="storagePlayerMediaArea" class="relative bg-black/40 w-full aspect-video md:aspect-auto md:h-[400px] flex items-center justify-center overflow-hidden">
              <video id="storageVideoPlayer" class="w-full h-full object-contain hidden" playsinline></video>
              
              <!-- MP3 Audio Visualizer Wrapper -->
              <div id="storageAudioWrapper" class="w-full h-full hidden flex-col items-center justify-center p-6 bg-gradient-to-br from-[#0f172a] to-[#1e1e1e] relative">
                  <!-- Decorative Background Glow -->
                  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-primary/20 rounded-full blur-[80px] pointer-events-none"></div>
                  
                  <!-- Gradient Thumbnail -->
                  <div class="w-32 h-32 md:w-48 md:h-48 rounded-2xl bg-gradient-to-tr from-primary via-secondary to-pink-500 shadow-2xl flex items-center justify-center mb-6 relative overflow-hidden z-10 hover:scale-105 transition-transform duration-500">
                      <div class="absolute inset-0 bg-black/20"></div>
                      <span class="material-symbols-outlined text-white/80 text-6xl drop-shadow-lg z-10">music_note</span>
                  </div>
                  
                  <!-- Spectrum Canvas -->
                  <canvas id="storageAudioCanvas" class="w-full max-w-md h-16 md:h-20 z-10"></canvas>
              </div>

              <audio id="storageAudioPlayer" class="hidden"></audio>
          </div>
          <!-- Controls Area -->
          <div class="p-6 bg-white/5 flex flex-col gap-5 border-t border-white/10">
              <!-- Progress -->
              <div class="flex items-center gap-4">
                  <span id="storagePlayerCurrentTime" class="text-xs text-white/50 w-10 text-right font-mono">0:00</span>
                  <div class="flex-grow relative h-1.5 md:h-2 bg-white/10 rounded-full cursor-pointer group" id="storagePlayerProgressContainer">
                      <div id="storagePlayerProgressBar" class="absolute top-0 left-0 h-full bg-primary rounded-full w-0 pointer-events-none transition-all duration-100 group-hover:bg-secondary">
                          <div class="absolute right-0 top-1/2 -translate-y-1/2 w-3 h-3 bg-white rounded-full opacity-0 group-hover:opacity-100 transition-opacity shadow-glow"></div>
                      </div>
                  </div>
                  <span id="storagePlayerDuration" class="text-xs text-white/50 w-10 font-mono">0:00</span>
              </div>
              
              <!-- Buttons -->
              <div class="flex flex-row items-center justify-between w-full gap-2">
                  <!-- Left: Volume -->
                  <div class="flex items-center justify-start flex-1 gap-1 md:gap-2">
                      <button id="storagePlayerMuteBtn" class="text-white/70 hover:text-primary transition-colors p-1 md:p-2"><span class="material-symbols-outlined text-lg md:text-2xl">volume_up</span></button>
                      <input type="range" id="storagePlayerVolume" min="0" max="1" step="0.05" value="1" class="w-12 md:w-24 h-1 bg-white/10 rounded-lg appearance-none cursor-pointer focus:outline-none hover:bg-white/20 transition-colors">
                  </div>
                  
                  <!-- Center: Playback -->
                  <div class="flex items-center justify-center gap-1 md:gap-4 flex-none">
                      <button id="storagePlayerPrevBtn" class="text-white/80 hover:text-primary transition-colors p-1 md:p-2"><span class="material-symbols-outlined text-2xl md:text-3xl">skip_previous</span></button>
                      <button id="storagePlayerPlayBtn" class="text-white bg-primary hover:bg-primary-hover rounded-full w-12 h-12 md:w-14 md:h-14 transition-transform hover:scale-105 active:scale-95 flex items-center justify-center shadow-[0_0_15px_rgba(6,185,249,0.4)] mx-1 md:mx-2">
                          <span class="material-symbols-outlined text-3xl md:text-4xl">play_arrow</span>
                      </button>
                      <button id="storagePlayerNextBtn" class="text-white/80 hover:text-primary transition-colors p-1 md:p-2"><span class="material-symbols-outlined text-2xl md:text-3xl">skip_next</span></button>
                  </div>
                  
                  <!-- Right: Repeat -->
                  <div class="flex items-center justify-end flex-1">
                      <button id="storagePlayerRepeatBtn" class="text-white/50 hover:text-white transition-colors flex items-center justify-center p-2 rounded-full hover:bg-white/5 relative" title="Repeat Off">
                          <span class="material-symbols-outlined text-[20px] md:text-[24px]" id="storagePlayerRepeatIcon">repeat</span>
                          <span id="storagePlayerRepeatBadge" class="absolute -top-1 -right-1 text-[9px] font-bold bg-primary text-on-primary rounded px-1 min-w-[14px] text-center hidden">1</span>
                      </button>
                  </div>
              </div>
          </div>
      </div>
  </div>
    <!-- Settings Modal -->
    <div id="settingsModal" class="fixed inset-0 bg-black/60 z-[100] hidden items-center justify-center p-4 backdrop-blur-sm">
        <div class="glass-panel p-4 md:p-5 rounded-2xl max-w-sm w-full border border-white/10 shadow-2xl relative">
            <button id="closeSettingsBtn" class="absolute top-3 right-3 text-white/50 hover:text-white transition-colors outline-none">
                <span class="material-symbols-outlined text-[20px]">close</span>
            </button>
            <div class="border-b-2 border-primary/80 pb-3 mb-4">
                <h2 class="text-base font-h2 text-primary flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[20px]">settings</span> Global Settings
                </h2>
            </div>
            
            <div class="flex flex-col gap-4">
                <!-- Browser Cookies -->
                <div class="border border-white/20 rounded-xl p-3 bg-white/5">
                    <div class="border-b border-white/20 pb-1.5 mb-2">
                        <label class="block text-[13px] text-white/90 font-medium tracking-wide">Allow Cookies</label>
                    </div>
                    <p class="text-[11px] text-white/50 mb-3 leading-relaxed">
                        Select the browser you use to login to Instagram/TikTok. FythhX will read your login session automatically when downloading.
                    </p>
                    <div class="flex items-center gap-2">
                        <div class="relative flex-1" id="customBrowserDropdown">
                            <button type="button" id="browserSelectBtn" class="w-full glass-inner text-on-surface rounded-lg py-2 px-3 hover:border-secondary transition-all cursor-pointer outline-none flex justify-between items-center glass-panel text-[12px]">
                                <span id="browserSelectLabel">No Cookies (Default)</span>
                                <span class="material-symbols-outlined text-outline-variant pointer-events-none transition-transform duration-200 text-[18px]" id="browserSelectIcon">expand_more</span>
                            </button>
                            <div id="browserDropdownMenu" class="absolute z-50 w-full mt-1.5 glass-dropdown rounded-lg shadow-2xl custom-select-menu closed flex flex-col overflow-hidden max-h-48 overflow-y-auto">
                                <button type="button" class="browser-option w-full text-left px-3 py-2 text-[12px] text-white hover:bg-secondary/20 hover:text-secondary transition-colors" data-value="none">No Cookies (Default)</button>
                                <button type="button" class="browser-option w-full text-left px-3 py-2 text-[12px] text-white hover:bg-secondary/20 hover:text-secondary transition-colors" data-value="chrome">Google Chrome</button>
                                <button type="button" class="browser-option w-full text-left px-3 py-2 text-[12px] text-white hover:bg-secondary/20 hover:text-secondary transition-colors" data-value="edge">Microsoft Edge</button>
                                <button type="button" class="browser-option w-full text-left px-3 py-2 text-[12px] text-white hover:bg-secondary/20 hover:text-secondary transition-colors" data-value="firefox">Mozilla Firefox</button>
                                <button type="button" class="browser-option w-full text-left px-3 py-2 text-[12px] text-white hover:bg-secondary/20 hover:text-secondary transition-colors" data-value="brave">Brave Browser</button>
                                <button type="button" class="browser-option w-full text-left px-3 py-2 text-[12px] text-white hover:bg-secondary/20 hover:text-secondary transition-colors" data-value="opera">Opera</button>
                                <button type="button" class="browser-option w-full text-left px-3 py-2 text-[12px] text-white hover:bg-secondary/20 hover:text-secondary transition-colors" data-value="vivaldi">Vivaldi</button>
                            </div>
                            <input type="hidden" id="browserSelect" value="none">
                        </div>
                        
                        <button id="saveSettingsBtn" class="shrink-0 text-primary hover:text-primary-container hover:drop-shadow-[0_0_8px_rgba(2,206,255,0.8)] transition-all hover:scale-110 active:scale-95 outline-none flex items-center justify-center p-1.5" title="Simpan Pengaturan">
                            <span class="material-symbols-outlined text-[20px]">task_alt</span>
                        </button>
                    </div>
                </div>

                <!-- Clear Cache -->
                <div class="border border-white/20 rounded-xl p-3 bg-white/5">
                    <div class="border-b border-white/20 pb-1.5 mb-2">
                        <label class="block text-[13px] text-white/90 font-medium tracking-wide">Clear Cache</label>
                    </div>
                    <div class="flex items-center justify-between gap-3">
                        <p class="text-[11px] text-white/50 leading-relaxed flex-1">
                            Delete all temporary files (thumbnails, filmstrips, raw audio) to free up disk space.
                        </p>
                        <button id="clearCacheBtn" class="shrink-0 text-error hover:text-error-container hover:drop-shadow-[0_0_8px_rgba(255,180,171,0.8)] transition-all hover:scale-110 active:scale-95 outline-none flex items-center justify-center p-1.5" title="Clear Cache">
                            <span class="material-symbols-outlined text-[20px]">delete</span>
                        </button>
                    </div>
                </div>

                <!-- About Us -->
                <div class="border border-white/20 rounded-xl p-3 bg-white/5 flex flex-col gap-2">
                    <div class="border-b border-white/20 pb-1.5 mb-1">
                        <label class="block text-[13px] text-white/90 font-medium tracking-wide">About FythhX</label>
                    </div>
                    <p class="text-[11px] text-white/70 leading-relaxed">
                        FythhX is an all-in-one tool running locally on your computer. It is designed specifically for creators to help download, trim videos directly from the server (without full download), and find important moments (Heatmap).
                    </p>
                    <div class="border-t border-white/10 pt-2 mt-1">
                        <p class="text-center text-white/40 text-[9px] font-mono leading-relaxed">
                            &copy; 2026 FythhX.<br>All rights reserved.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
  
    <!-- Scripts -->
  <script src="timeline/TimelineEngine.js"></script>
  <script src="app.js"></script>
  <script src="js/clipper.js"></script>

  <script src="js/storage.js"></script>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const inputField = document.getElementById("urlInput");
      if (!inputField) return;
      
      let textToType = 'Paste your YouTube, Instagram, or TikTok link here...';
      let charIndex = 0;
      let isTyping = true;
      let typingInterval = null;
      let isUserFocused = false;

      // Listen for language changes to update typing text
      window.addEventListener('languageChanged', () => {
        textToType = 'Paste link YouTube, Instagram, TikTok disini...';
        if (isUserFocused) {
          inputField.setAttribute("placeholder", textToType);
        }
      });

      function startTypingEffect() {
        if (isUserFocused || inputField.value !== "") return;
        
        clearInterval(typingInterval);
        
        typingInterval = setInterval(() => {
          if (isUserFocused || inputField.value !== "") {
            clearInterval(typingInterval);
            inputField.setAttribute("placeholder", textToType);
            return;
          }

          if (isTyping) {
            if (charIndex <= textToType.length) {
              inputField.setAttribute("placeholder", textToType.substring(0, charIndex) + "|");
              charIndex++;
            } else {
              isTyping = false;
              clearInterval(typingInterval);
              setTimeout(startTypingEffect, 2500); // Wait 2.5s before deleting
            }
          } else {
            if (charIndex >= 0) {
              inputField.setAttribute("placeholder", textToType.substring(0, charIndex) + "|");
              charIndex--;
            } else {
              isTyping = true;
              clearInterval(typingInterval);
              setTimeout(startTypingEffect, 800); // Wait before re-typing
            }
          }
        }, 60); // typing speed
      }

      setTimeout(startTypingEffect, 1000);

      inputField.addEventListener("focus", () => {
        isUserFocused = true;
        clearInterval(typingInterval);
        inputField.setAttribute("placeholder", textToType);
      });

      inputField.addEventListener("blur", () => {
        isUserFocused = false;
        if (inputField.value === "") {
          charIndex = 0;
          isTyping = true;
          startTypingEffect();
        }
      });
    });
  </script>

  <script>
    // Dynamic Loader Text Rotation
    document.addEventListener("DOMContentLoaded", () => {
      const loaderContainer = document.getElementById("loaderContainer");
      const loaderDynamicText = document.getElementById("loaderDynamicText");
      
    let loadingPhrases = [
      'ANALYZING LINK...',
      'FETCHING VIDEO METADATA...',
      'FINDING THE BEST MOMENTS...',
      'CONVERTING FORMAT...',
      'PLEASE WAIT, PROCESSING IS IN PROGRESS...',
      'PREPARING DOWNLOAD...'
    ];

      window.addEventListener('languageChanged', () => {
        loadingPhrases = [
          'MENGANALISA TAUTAN...',
          'MENGAMBIL METADATA VIDEO...',
          'MENCARI MOMEN TERBAIK...',
          'MENGONVERSI FORMAT...',
          'HARAP BERSABAR, PROSES SEDANG BERJALAN...',
          'MENYIAPKAN HASIL UNDUHAN...'
        ];
        if (!loaderContainer.classList.contains("hidden")) {
           loaderDynamicText.innerText = loadingPhrases[phraseIndex % loadingPhrases.length];
        }
      });
      
      let phraseIndex = 0;
      let textInterval;

      // Observe when loaderContainer is shown/hidden
      const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          if (mutation.type === "attributes" && mutation.attributeName === "class") {
            if (!loaderContainer.classList.contains("hidden")) {
              // Loader is shown, start rotating text
              phraseIndex = 0;
              loaderDynamicText.innerText = loadingPhrases[phraseIndex];
              
              clearInterval(textInterval);
              textInterval = setInterval(() => {
                phraseIndex = (phraseIndex + 1) % loadingPhrases.length;
                loaderDynamicText.style.opacity = 0; // Fade out slightly for transition
                setTimeout(() => {
                  loaderDynamicText.innerText = loadingPhrases[phraseIndex];
                  loaderDynamicText.style.opacity = 1;
                }, 200);
              }, 2500); // Change text every 2.5 seconds
            } else {
              // Loader is hidden, stop rotating
              clearInterval(textInterval);
            }
          }
        });
      });

      observer.observe(loaderContainer, { attributes: true });
    });
  </script>
  <script src="js/multiTrimLogic.js"></script>
    <!-- Confirm Delete Modal -->
    <div id="confirmModal" class="fixed inset-0 bg-black/80 z-[110] hidden items-center justify-center p-4 backdrop-blur-sm transition-opacity duration-300 opacity-0">
        <div id="confirmModalContent" class="glass-panel glass-inner border border-red-500/30 rounded-xl p-6 max-w-sm w-full shadow-2xl transform scale-95 transition-transform duration-300">
            <div class="flex items-center gap-3 mb-4 text-error">
                <span class="material-symbols-outlined text-[28px]">warning</span>
                <h3 class="font-h2 text-lg">Delete File?</h3>
            </div>
            <p class="text-white/70 text-sm mb-6" id="confirmModalText">Are you sure you want to permanently delete this file from the server?</p>
            <div class="flex justify-end gap-3">
                <button id="cancelConfirmBtn" class="px-4 py-2 rounded-lg bg-white/5 hover:bg-white/10 text-white/80 transition-colors text-sm">Cancel</button>
                <button id="okConfirmBtn" class="px-4 py-2 rounded-lg bg-red-500/20 hover:bg-red-500/40 text-red-400 border border-red-500/30 transition-colors text-sm flex items-center gap-2">
                    <span class="material-symbols-outlined text-[16px]">delete</span> Delete
                </button>
            </div>
        </div>
    </div>

</body>
</html>
